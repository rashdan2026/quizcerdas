# ==============================================================
# CONTOH KONFIGURASI PRODUCTION — HOSTINGER SHARED HOSTING
# Salin ke file `.env` di server production dan isi nilai nyata.
# JANGAN commit file .env berisi nilai rahasia ke git.
# ==============================================================

# WAJIB: production menonaktifkan debug toolbar, menyembunyikan detail
# error ke pengguna, dan mengurangi beban CPU/RAM per request.
CI_ENVIRONMENT = production

# URL aplikasi (tanpa trailing slash), sesuaikan domain/subfolder.
app.baseURL = 'https://domainanda.example.com/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'

# Database dari hPanel Hostinger (MySQL/MariaDB).
# Gunakan host yang diberikan hPanel (bukan localhost) bila remote;
# di dalam hosting biasanya tetap localhost.
database.default.hostname = localhost
database.default.database = u123456789_quizcerdas
database.default.username = u123456789_admin
database.default.password = 'GANTI_DENGAN_PASSWORD_KUAT'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# OTP mail API (endpoint & key milik aplikasi).
otp.mailApiUrl = 'https://gmail.webriau.com/servera.php'
otp.mailApiKey = 'GANTI_KEY_ANDA'

# Geo-validasi absensi (sesuaikan kebutuhan kampus).
attendance.requireGeo = true

# SMTP untuk email aplikasi (TurboSMTP / layanan lain).
turboSmtp.consumerKey = 'GANTI_CONSUMER_KEY'
turboSmtp.consumerSecret = 'GANTI_CONSUMER_SECRET'

# Kebijakan malware scan PDF:
#   strict  = tolak bila pemindai tidak tersedia/gagal (paling aman)
#   relaxed = izinkan bila pemindai tidak tersedia (kurang aman)
# Di shared hosting tanpa ClamAV, diskusikan dengan administrator
# sebelum memilih relaxed.
quiz.malwarePolicy = strict

# Batas token AI per batch generate soal (default 400000).
# quiz.maxBatchTokens = 400000

# Catatan kunci AI (OpenRouter) TIDAK ada di .env:
# kunci provider AI tersimpan terenkripsi di tabel quiz_ai_providers
# dan dikelola lewat halaman Admin -> Quiz AI.
