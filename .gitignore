.env
.env.*
!.env.example
!.env.production.example

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.qwen/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documentation folder (local only)
/doc/

# Development and Test files
tests/
phpunit.xml.dist
preload.php
server.php
test_*.php
*_test.php
*_tester.php
debug*.php
update-pass.php

# Diagnostik/admin browser JANGAN ikut deployment (akses publik di public/)
public/check.php
public/simple-check.php
public/test-report.php
public/_test_v586.php
public/run-migrations.php
public/run-migration-dosen.php
