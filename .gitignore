# Temporary and Debug scripts
update_*.php
cleanup_*.php
verify_*.php
remove_*.php

# Media files (non-essential)
error.jpg
error.jpeg
gambar.png

# Third-party library docs
system/ThirdParty/*/LICENSE*.md
system/ThirdParty/*/README*.md
system/ThirdParty/*/CHANGELOG*.md

# Composer
# Composer vendor: ikut di-commit agar production (Hostinger) tidak perlu
# menjalankan composer install. Paket dev sudah dihapus dari composer.json,
# jadi vendor/ hanya berisi dependensi production (~0.6 MB).
!vendor/
!vendor/**
# Pengecualian: aset vendor FRONTEND (Quill, Highlight.js) harus ikut di-deploy
!public/assets/vendor/
!public/assets/vendor/**

# Writable folder contents
writable/logs/*
!writable/logs/.htaccess
writable/session/*
!writable/session/.htaccess
writable/cache/*
!writable/cache/.htaccess
writable/debugbar/*
!writable/debugbar/.htaccess
writable/uploads/*
!writable/uploads/.htaccess
writable/quiz_tmp/*
!writable/quiz_tmp/.htaccess
writable/exports/*
writable/loadtest-results/*
# Kunci enkripsi API AI — dibuat otomatis per server, JANGAN masuk git.
writable/quiz_secret.key

# Backup files
*.bak
*.backup
*.sql.gz
*.sql.bz2
