#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://yourdomain.com/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_username
database.default.password = your_password
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

#--------------------------------------------------------------------
# OTP MAIL SERVICE (Gmail API / Webriau.com)
#--------------------------------------------------------------------

otp.mailApiUrl = 'https://gmail.webriau.com/servera.php'
otp.mailApiKey = 'your-gmail-api-key-here'

#--------------------------------------------------------------------
# EMAIL GATEWAY & RESEND (pengganti TurboSMTP)
#--------------------------------------------------------------------
# true  = provider dipilih MAIL_PROVIDER (resend|gmail|webriau)
#         resend = Resend dulu; jika error (termasuk 429/kuota) fallback Gmail/Webriau
# false = perilaku lama: Gmail/Webriau dulu, fallback Resend
MAIL_GATEWAY_ENABLED = true
MAIL_PROVIDER = resend

MAIL_FROM_ADDRESS = 'noreply@kelasmerdeka.com'
MAIL_FROM_NAME = 'Kelas Merdeka'
MAIL_TIMEOUT_SECONDS = 15
MAIL_CONNECT_TIMEOUT_SECONDS = 8

RESEND_API_KEY = 're_your_resend_api_key'
RESEND_API_URL = 'https://api.resend.com'

#--------------------------------------------------------------------
# ATTENDANCE
#--------------------------------------------------------------------

attendance.requireGeo = true


#--------------------------------------------------------------------
# QUIZ (AI QUESTION GENERATION)
#--------------------------------------------------------------------
# Kebijakan pemindaian keamanan PDF saat antivirus tidak tersedia di server:
#   strict  = tanpa engine AV (ClamAV/Defender) file PDF DITOLAK (default lama)
#   relaxed = fallback pemeriksaan heuristik konten PDF (JavaScript/Launch/
#             OpenAction/EmbeddedFile/RichMedia ditolak) - aman untuk shared hosting
quiz.malwarePolicy = relaxed
# Path opsional ClamAV (Linux: clamscan) / Windows Defender agar pemindaian penuh
# quiz.clamavPath = '/usr/bin/clamscan'
# quiz.defenderPath = 'C:\Program Files\Windows Defender\MpCmdRun.exe'
# Matikan penalaran tersembunyi model AI (hemat token & cegah output terpotong)
quiz.disableReasoning = true
